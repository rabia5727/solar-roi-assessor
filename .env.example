# --- AI (optional) ---
# Free key: https://aistudio.google.com/apikey
# Without a key the app still works: bill reading is off and the summary uses a built-in template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Price admin (/admin) ---
# Choose any password. Admin is disabled until this is set.
ADMIN_PASSWORD=

# --- Daily price check ---
# Runs automatically when prices are over a day old. Set to "off" to disable.
AUTO_PRICE_CHECK=on
# On Vercel: any random string; Vercel's daily schedule (vercel.json) uses it.
CRON_SECRET=

# --- Saving prices on Vercel (not needed on your own PC) ---
# Free Redis at https://upstash.com (or Vercel > Storage > Upstash). Locally, prices save to data/prices.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
